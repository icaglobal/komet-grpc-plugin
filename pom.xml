<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>164</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.komet</groupId>
    <artifactId>komet-grpc-plugin</artifactId>
    <version>2-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Komet gRPC Plugin</name>
    <description>
        External plug-in point for gRPC-backed remote search and datastore access in Komet.
        Owns the full gRPC client implementation (GrpcSearchService, GrpcPrimitiveDataService,
        GrpcSearchClient) formerly in tinkar-core's grpc-search-provider module. Registers the
        "Connect to gRPC service" data store controller and the RemoteConceptSearchService
        lookup that kview's search UI discovers generically — without Komet's core modules
        requiring any gRPC-specific dependency.
    </description>
    <url>https://ike.network/komet-grpc-plugin/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <scm>
        <connection>scm:git:https://github.com/icaglobal/komet-grpc-plugin.git</connection>
        <developerConnection>scm:git:git@github.com:icaglobal/komet-grpc-plugin.git</developerConnection>
        <url>https://github.com/icaglobal/komet-grpc-plugin</url>
        <tag>HEAD</tag>
    </scm>

    <!-- Required: ike-parent's enforcer fails an inheriting project whose
         effective site URL still starts with https://ike.network/ike-platform/
         while its groupId is not network.ike.platform (ike-issues#380/#383). -->
    <distributionManagement>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/komet-grpc-plugin/</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- Main-line Komet BOM; manages komet module + tinkar versions. -->
        <komet-bom.version>3.0.7</komet-bom.version>
        <!-- Not managed by komet-bom; matches tinkar-core.version there. -->
        <tinkar-core.version>1.127.2</tinkar-core.version>
        <tinkar-schema.version>1.43.0</tinkar-schema.version>
        <grpc.version>1.78.0</grpc.version>
        <protobuf.version>4.30.2</protobuf.version>
        <protobuf-java.version>4.30.2-r3</protobuf-java.version>
        <tinkar-jpms-deps.groupId>dev.ikm.jpms</tinkar-jpms-deps.groupId>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.ikm.komet</groupId>
                <artifactId>komet-bom</artifactId>
                <version>${komet-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            grpc-netty-shaded is the transport (Netty + grpc-netty in one jar), and
            grpc-core the implementation behind it.

            'compile' scope, not 'runtime': both are shaded into this jar (see the
            shade <artifactSet>) and module-info now names their provider classes in
            `provides` clauses, which the compiler resolves against the COMPILE
            classpath. Runtime scope hid them from javac and the module-info would not
            compile. This also matches the scope rule documented for grpc-api/stub/
            protobuf above — shade's artifact filter follows Maven scope semantics.
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
            <version>${grpc.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId></exclusion>
                <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
                <exclusion><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId></exclusion>
                <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
                <exclusion><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId></exclusion>
            </exclusions>
        </dependency>

        <!--
            grpc-api, grpc-stub, grpc-protobuf are all automatic modules, shaded into this jar
            (see the maven-shade-plugin config below) so jlink sees a single named module.
            Must be 'compile' scope, not 'provided': maven-shade-plugin's artifact-gathering
            for its <artifactSet><includes> filter follows Maven's own scope semantics
            (provided = supplied by the runtime environment, excluded from the runtime/package
            classpath) — 'provided'-scope deps silently log "No artifact matching filter" and
            never actually get shaded in, which then fails at runtime with NoClassDefFoundError
            once this jar is on the module path without grpc-api/grpc-stub/grpc-protobuf present
            as separate (automatic) modules.
            NOTE: 'compile' scope means these DO appear as transitive dependencies in the
            installed POM (shade-plugin's dependency reduction doesn't apply to this project's
            Maven-4 "consumer pom"; 'optional=true' was tried and also breaks the shading step
            itself). Any FUTURE consumer of this plugin jar would need to exclude these — not a
            concern today since application depends on this jar directly and doesn't re-shade it.
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId></exclusion>
                <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
                <exclusion><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId></exclusion>
                <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
                <exclusion><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId></exclusion>
                <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
                <exclusion><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <!-- grpc-netty-shaded pulls in perfmark at runtime -->
        <dependency>
            <groupId>io.perfmark</groupId>
            <artifactId>perfmark-api</artifactId>
            <version>0.27.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Protobuf runtime — JPMS-wrapped -->
        <dependency>
            <groupId>${tinkar-jpms-deps.groupId}</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf-java.version}</version>
        </dependency>
        <!-- Tinkar schema message classes (from Tinkar.proto) -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>tinkar-schema</artifactId>
            <version>${tinkar-schema.version}</version>
        </dependency>
        <!-- JPMS-wrapped javax.annotation (module: dev.ikm.jpms.javax.annotation) -->
        <dependency>
            <groupId>${tinkar-jpms-deps.groupId}</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2-r7</version>
        </dependency>
        <!-- Guava — needed by gRPC generated async stubs; shaded in. 'compile' scope for the
             same reason as grpc-api/grpc-stub/grpc-protobuf above. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.1.0-jre</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
                <exclusion><groupId>com.google.errorprone</groupId><artifactId>error_prone_annotations</artifactId></exclusion>
                <exclusion><groupId>com.google.j2objc</groupId><artifactId>j2objc-annotations</artifactId></exclusion>
                <exclusion><groupId>com.google.guava</groupId><artifactId>listenablefuture</artifactId></exclusion>
                <exclusion><groupId>org.checkerframework</groupId><artifactId>checker-qual</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.google.errorprone</groupId>
            <artifactId>error_prone_annotations</artifactId>
            <version>2.26.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- SearchService interface + PrimitiveDataSearchResult -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>search-provider</artifactId>
            <version>${tinkar-core.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- RemoteConceptSearchService / NoLocalUserStore / DataServiceController / ServiceLifecycle SPI.
             Version managed by komet-bom. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>common</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Entity module: TinkarSchemaToEntityTransformer + EntityService for concept loading -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity</artifactId>
            <version>${tinkar-core.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Eclipse Collections API: ImmutableList, IntProcedure, Lists.immutable -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
            <version>13.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>--add-reads</arg>
                        <arg>dev.ikm.tinkar.provider.grpc=ALL-UNNAMED</arg>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Extract Tinkar.proto from the tinkar-schema jar for use by protoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-tinkar-schema-proto</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>dev.ikm.tinkar</groupId>
                                    <artifactId>tinkar-schema</artifactId>
                                    <version>${tinkar-schema.version}</version>
                                    <includes>Tinkar.proto</includes>
                                    <outputDirectory>${project.build.directory}/proto-deps</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate Java classes from tinkar_search.proto -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <protocVersion>${protobuf.version}</protocVersion>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <importPaths>
                        <importPath>${project.build.directory}/proto-deps</importPath>
                    </importPaths>
                    <binaryMavenPlugins>
                        <binaryMavenPlugin>
                            <groupId>io.grpc</groupId>
                            <artifactId>protoc-gen-grpc-java</artifactId>
                            <version>${grpc.version}</version>
                        </binaryMavenPlugin>
                    </binaryMavenPlugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Shade grpc-api, grpc-stub, grpc-protobuf, and guava into this jar.
                These are automatic modules and cannot be in a jlink image as separate entries.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createSourcesJar>false</createSourcesJar>
                            <!--
                                This module uses Maven 4's <parent/> shorthand in its sibling
                                tinkar-core origin; kept here for parity even though this pom
                                has a real parent. Disabled regardless since consumers already
                                exclude the shaded transitive deps explicitly where needed, and
                                the reduced pom doesn't affect what gets installed/resolved here.
                            -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>io.grpc:grpc-api</include>
                                    <include>io.grpc:grpc-stub</include>
                                    <include>io.grpc:grpc-protobuf</include>
                                    <include>io.grpc:grpc-protobuf-lite</include>
                                    <include>com.google.guava:guava</include>
                                    <include>com.google.guava:failureaccess</include>
                                    <!--
                                        The gRPC RUNTIME half: a channel transport plus the core
                                        implementation. Without these the jar carries grpc-api's
                                        `uses io.grpc.ManagedChannelProvider` but nothing that
                                        PROVIDES one, and the plugin dies at startup with
                                        "No functional channel service provider found".

                                        These used to arrive on the boot modulepath via
                                        komet/application's dependency on this jar. komet-desktop
                                        now stages this plugin as a SINGLE jar into the runtime
                                        plugins/ layer, and transitive runtime dependencies are not
                                        staged alongside it — so the transport must live inside.

                                        grpc-netty-shaded holds only io/grpc/netty/**, so it does
                                        not split-package with grpc-api's io.grpc.*; grpc-core owns
                                        io.grpc.internal.** and supplies the default load-balancer
                                        and DNS name-resolver. ServicesResourceTransformer merges
                                        their META-INF/services entries, and module-info declares
                                        the matching `provides` — a named module ignores
                                        META-INF/services.
                                    -->
                                    <include>io.grpc:grpc-netty-shaded</include>
                                    <include>io.grpc:grpc-core</include>
                                    <include>io.grpc:grpc-util</include>
                                    <include>io.grpc:grpc-context</include>
                                    <include>io.perfmark:perfmark-api</include>
                                    <include>com.google.android:annotations</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>io.grpc:grpc-api</artifact>
                                    <excludes><exclude>META-INF/versions/*/module-info.class</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>io.grpc:grpc-stub</artifact>
                                    <excludes><exclude>META-INF/versions/*/module-info.class</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>io.grpc:grpc-protobuf</artifact>
                                    <excludes><exclude>META-INF/versions/*/module-info.class</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>io.grpc:grpc-protobuf-lite</artifact>
                                    <excludes><exclude>META-INF/versions/*/module-info.class</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>com.google.guava:guava</artifact>
                                    <excludes><exclude>META-INF/versions/*/module-info.class</exclude></excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>module-info.class</resource>
                                    <file>${project.build.outputDirectory}/module-info.class</file>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
